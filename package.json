{
  "name": "exploding-kittens-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:open": "playwright-cli -s=kitten-check open http://127.0.0.1:5174/ --browser chrome",
    "test:browser": "playwright-cli -s=kitten-check run-code --filename=scripts/browser-smoke.js",
    "test:network": "playwright-cli -s=kitten-check run-code --filename=scripts/network-smoke.js",
    "test:chat": "playwright-cli -s=kitten-check run-code --filename=scripts/chat-smoke.js",
    "test:mobile-cards": "playwright-cli -s=kitten-check run-code --filename=scripts/mobile-cards-smoke.js",
    "test:reaction": "playwright-cli -s=kitten-check run-code --filename=scripts/reaction-smoke.js",
    "test:close": "playwright-cli -s=kitten-check close",
    "dev:relay": "wrangler dev --ip 127.0.0.1 --port 8788",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "vite": "^6.4.4",
    "wrangler": "4.151.3"
  }
}
