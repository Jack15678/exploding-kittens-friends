{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exploding-kittens-friends",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomRelay"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jack15678.github.io"
  },
  "observability": {
    "enabled": false
  }
}
